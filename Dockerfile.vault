FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev --extra vault

COPY src ./src
COPY README.md ./
RUN uv sync --frozen --no-dev --extra vault

ENV PATH="/app/.venv/bin:${PATH}"

EXPOSE 8000

ENTRYPOINT ["uvicorn", "missions.the_vault.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
