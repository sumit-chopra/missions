# Copy to .env and fill in your key. .env is gitignored.
#   cp .env.example .env

OPENAI_API_KEY=

# Everything below is optional — leave commented out to use the defaults.
# An empty value is NOT the same as unset: `OPENAI_BASE_URL=` would send an
# empty base URL to the SDK and break it. Uncomment only to override.

# Override the API endpoint (proxy / compatible gateway).
# OPENAI_BASE_URL=

