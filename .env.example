# Copy to .env and fill in your credentials. .env is gitignored.

OPENAI_API_KEY=

# Optional: override the API endpoint
OPENAI_BASE_URL=

# Optional: the chat model to use.
MODEL_NAME=

# Optional: SQLite file holding the last 10 conversation turns.
# Defaults to .missions/glass_cockpit.db.
GLASS_COCKPIT_HISTORY_DB=
